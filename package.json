{
  "name": "shazbotcards",
  "version": "1.0.0",
  "description": "Full-stack card inventory management system for Sports, Pokémon, and MTG cards",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.5.1",
    "multer": "^1.4.5-lts.1"
  }
}
