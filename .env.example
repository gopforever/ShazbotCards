PORT=3001
DB_PATH=./data/shazbotcards.db

# eBay Developer App Credentials
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_REDIRECT_URI=http://localhost:3001/api/ebay/callback
EBAY_ENV=sandbox

# SportscardsPro API (https://www.sportscardspro.com/api-documentation)
SPORTSCARDSPRO_API_KEY=your_sportscardspro_api_key

# Image upload directory
UPLOADS_DIR=./uploads
MAX_IMAGE_SIZE_MB=10
